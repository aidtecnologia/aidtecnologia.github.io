---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="brand brand-footer">
      <img
        class="brand-mark"
        src={`${import.meta.env.BASE_URL}logo-aid.png`}
        alt=""
        width="32"
        height="32"
        loading="lazy"
      />
      <span class="brand-name">Tecnologia</span>
    </div>
    <p>© <span id="year">{new Date().getFullYear()}</span> {site.name}. Todos os direitos reservados.</p>
    <a href="#top">Voltar ao topo ↑</a>
  </div>
</footer>
