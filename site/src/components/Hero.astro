---
import { projects } from '../data/projects';
import { heroStackColumns } from '../data/stack';
import { site } from '../data/site';

const years = new Date().getFullYear() - site.startYear;

const columns = heroStackColumns.map((labels, columnIndex) =>
  labels.map((label, rowIndex) => ({
    label,
    className: `pill--r${rowIndex}`,
    side: columnIndex === 0 ? 'left' : 'right',
  })),
);
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Desenvolvimento de software sob medida</p>
        <h1>
          Sistemas, apps e <span class="gradient">inteligência artificial</span> para o seu negócio.
        </h1>
        <p class="lead">
          Da ideia ao deploy: projetamos, construímos e evoluímos produtos digitais com foco em
          resultado, performance e experiência de uso.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#projetos">Ver projetos</a>
          <a class="btn btn-ghost" href="#contato">Falar sobre um projeto</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="mock-shell">
          <div class="mock">
            <div class="mock-bar">
              <i></i><i></i><i></i>
              <span>aidtecnologia</span>
            </div>
            <div class="mock-body">
              <div class="mock-lines">
                <span></span><span></span><span></span>
              </div>
              <div class="mock-cta"></div>
              <div class="mock-grid">
                <div class="mock-card"></div>
                <div class="mock-card"></div>
                <div class="mock-card"></div>
                <div class="mock-card"></div>
              </div>
            </div>
          </div>
          {
            columns.map((column) => (
              <div class:list={['pill-col', `pill-col--${column[0].side}`]}>
                {column.map((pill) => (
                  <span class:list={['float-pill', pill.className]}>{pill.label}</span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <dl class="stats">
      <div>
        <dt>{years}+ anos</dt>
        <dd>construindo software</dd>
      </div>
      <div>
        <dt>{projects.length} projetos</dt>
        <dd>em produção e evolução</dd>
      </div>
      <div>
        <dt>Web · Mobile · IA</dt>
        <dd>stack completa</dd>
      </div>
    </dl>
  </div>
</section>
